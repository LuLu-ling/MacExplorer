<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="SidebarOpenPaneLength">240</x:Double>
    <x:Double x:Key="SidebarCompactOpenPaneLength">56</x:Double>
    <x:Double x:Key="OmnibarDefaultHeight">38</x:Double>
    <x:Double x:Key="OmnibarModeDefaultHeight">34</x:Double>
    <x:Double x:Key="OmnibarModeDefaultClickAreaWidth">46</x:Double>
    <CornerRadius x:Key="OmnibarDefaultCornerRadius">19</CornerRadius>
    <CornerRadius x:Key="OmnibarModeDefaultCornerRadius">17</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="TabItemBackgroundBrush" Opacity="0.75"
                     Color="{DynamicResource ControlSolidFillColorDefault}" />
    <SolidColorBrush x:Key="App.Theme.IconBaseBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="FileSelectionFillBrush" Opacity="0.22"
                     Color="{DynamicResource SystemAccentColor}" />
</ResourceDictionary>
