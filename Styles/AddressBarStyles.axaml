<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:MacExplorer.Controls">
    <!--
    Address chrome and path glyph adapted from Files Community:
    src/Files.App.Controls/Omnibar/Omnibar.xaml,
    src/Files.App.Controls/ThemedIcon/Styles/Icons.Common.xaml, and
    src/Files.App/UserControls/NavigationToolbar.xaml (MIT).
    Home glyph matches the sidebar Home item (Segoe Fluent Icons E80F).
    Breadcrumb dimensions adapted from src/Files.App.Controls/BreadcrumbBar/BreadcrumbBar.xaml.
    Copyright (c) Files Community. SPDX-License-Identifier: MPL-2.0
    This source form is available under https://mozilla.org/MPL/2.0/.

    MIT portions: Copyright (c) 2018 - present Files Community.
    Text presenter template: Copyright (c) .NET Foundation and Contributors (Avalonia, MIT).
    Permission is hereby granted, free of charge, to any person obtaining a copy of this software
    and associated documentation files (the "Software"), to deal in the Software without restriction,
    including without limitation the rights to use, copy, modify, merge, publish, distribute,
    sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is
    furnished to do so, subject to the following conditions:
    The above copyright notice and this permission notice shall be included in all copies or
    substantial portions of the Software.
    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING
    BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
    NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,
    DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
    -->
    <Styles.Resources>
        <StreamGeometry x:Key="AddressPathGlyph">m3,1.99C1.34,1.99,0,3.33,0,4.99v6c0,1.66,1.34,3,3,3h10c1.66,0,3-1.34,3-3v-6c0-1.66-1.34-3-3-3H3Zm.48,2.58c-.09-.4-.5-.66-.9-.56-.4.09-.66.5-.56.9l1.5,6.5c.09.4.5.66.9.56.4-.09.66-.5.56-.9l-1.5-6.5Zm6.77,7.42c.41,0,.75-.34.75-.75s-.34-.75-.75-.75-.75.34-.75.75.34.75.75.75Zm2.5,0c.41,0,.75-.34.75-.75s-.34-.75-.75-.75-.75.34-.75.75.34.75.75.75Zm-7.17-7.98c.4-.09.81.16.9.56l1.5,6.5c.09.4-.16.81-.56.9-.4.09-.81-.16-.9-.56l-1.5-6.5c-.09-.4.16-.81.56-.9Z</StreamGeometry>
        <ControlTheme x:Key="AddressEditorTheme" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="46,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="ContextFlyout" Value="{x:Null}" />
            <Setter Property="ClearSelectionOnLostFocus" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent" Cursor="IBeam">
                        <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                            <Panel>
                                <TextBlock Name="PART_Placeholder" Text="{TemplateBinding PlaceholderText}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="Center" />
                            </Panel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ctrl|AddressBar">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Chrome" CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                    <Grid Name="PART_BreadcrumbHost" ColumnDefinitions="Auto,*" Margin="2,0"
                          Height="34" VerticalAlignment="Center" Background="Transparent">
                        <Grid Name="PART_RootHost" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                            <Button Name="PART_RootButton" Classes="AddressSegment AddressRoot"
                                    AutomationProperties.Name="Home" ToolTip.Tip="Home">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="16" Width="16" Text="&#xE80F;"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button Name="PART_RootArrow" Grid.Column="1" Classes="AddressSegment AddressArrow"
                                    AutomationProperties.Name="Show Quick Access and Drives"
                                    ToolTip.Tip="Show Quick Access and Drives">
                                <PathIcon Classes="AddressChevron" Data="M1,1 L5,5 L1,9 L2,10 L7,5 L2,0 Z" />
                            </Button>
                        </Grid>
                        <ctrl:BreadcrumbOverflowPanel Name="PART_BreadcrumbPanel" Grid.Column="1"
                                                      ClipToBounds="True" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Name="PART_EditorHost" IsVisible="False">
                        <TextBox Name="PART_Editor" Theme="{StaticResource AddressEditorTheme}" FontSize="14"
                                 Foreground="{TemplateBinding Foreground}" PlaceholderText="Enter a path"
                                 AutomationProperties.Name="Folder path" AcceptsReturn="False" AcceptsTab="False" />
                        <Border Width="46" Height="34" Margin="3,0,0,0" CornerRadius="17"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <PathIcon Width="16" Height="16" Data="{StaticResource AddressPathGlyph}"
                                      Foreground="{DynamicResource App.Theme.IconBaseBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ctrl|AddressBar:pointerover /template/ Border#PART_Chrome">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="ctrl|AddressBar:editing /template/ Border#PART_Chrome">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ctrl|AddressBar:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.AddressSegment">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AddressSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.AddressSegment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.AddressRoot">
        <Setter Property="Padding" Value="16,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="16,2,2,16" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.AddressOverflow">
        <Setter Property="Width" Value="34" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AddressArrow">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.AddressChevron">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="ctrl|SearchField">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Width" Value="240" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Chrome" CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                    <TextBox Name="PART_Editor" Theme="{StaticResource AddressEditorTheme}"
                             FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             PlaceholderText="{TemplateBinding Placeholder}"
                             AutomationProperties.Name="Search" AcceptsReturn="False" AcceptsTab="False" />
                    <Border Width="36" Height="34" Margin="3,0,0,0" CornerRadius="17"
                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"
                                   Text="&#xE721;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Theme.IconBaseBrush}" />
                    </Border>
                    <Button Name="PART_Clear" Classes="SearchClear"
                            AutomationProperties.Name="Clear" ToolTip.Tip="Clear">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ctrl|SearchField:pointerover /template/ Border#PART_Chrome">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="ctrl|SearchField:focus-within /template/ Border#PART_Chrome">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ctrl|SearchField:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ctrl|SearchField /template/ TextBox#PART_Editor">
        <Setter Property="Padding" Value="36,0,32,0" />
    </Style>
    <Style Selector="ctrl|SearchField:empty /template/ TextBox#PART_Editor">
        <Setter Property="Padding" Value="36,0,8,0" />
    </Style>
    <Style Selector="ctrl|SearchField:empty /template/ Button#PART_Clear">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.SearchClear">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2,16,16,2" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.SearchClear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.SearchClear:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
</Styles>
