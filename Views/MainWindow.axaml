<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:MacExplorer.ViewModels"
                 xmlns:m="using:MacExplorer.Models"
                 xmlns:views="using:MacExplorer.Views"
                 xmlns:conv="using:MacExplorer.Converters"
                 xmlns:ctrl="using:MacExplorer.Controls"

                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 x:Class="MacExplorer.Views.MainWindow"
                 x:DataType="vm:MainViewModel"
                 Title="{Binding WindowTitle}"
                 Width="1280" Height="800"
                 MinWidth="720" MinHeight="480"
                 TransparencyLevelHint="Mica,AcrylicBlur,None"
                 ExtendClientAreaToDecorationsHint="True"
                 ExtendClientAreaTitleBarHeightHint="48">
    <wnd:FAAppWindow.KeyBindings>
        <KeyBinding Gesture="Meta+L" Command="{Binding FocusPathCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding SelectedTab.RenameCommand}" />
        <KeyBinding Gesture="Alt+Enter" Command="{Binding OpenPropertiesCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding SelectedTab.RefreshCommand}" />
    </wnd:FAAppWindow.KeyBindings>

    <Grid RowDefinitions="48,48,*">
        <Border x:Name="TitleBarHost" Background="Transparent" Height="48"
                PointerPressed="TitleBar_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="78,10,0,0"
                  PointerWheelChanged="TabStrip_OnPointerWheelChanged">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <RepeatButton x:Name="TabScrollDecreaseButton" Classes="TabScrollButton"
                                  Delay="50" Interval="100" Content="&#xEDD9;"
                                  IsVisible="False" Click="TabScrollDecrease_OnClick" />
                    <ScrollViewer x:Name="TabScroller"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ScrollChanged="TabScroller_OnScrollChanged">
                        <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerTabViewModel">
                                    <Border Classes="TabItem" Classes.selected="{Binding IsSelectedTab}"
                                            Classes.closing="{Binding IsClosing}"
                                            Tag="{Binding}"
                                            PointerPressed="Tab_OnPointerPressed"
                                            PointerMoved="Tab_OnPointerMoved"
                                            PointerReleased="Tab_OnPointerReleased"
                                            PointerCaptureLost="Tab_OnPointerCaptureLost"
                                            AttachedToVisualTree="Tab_OnAttachedToVisualTree"
                                            ContextRequested="Tab_OnContextRequested">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="10,0,6,0">
                                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{Binding Marker}"
                                                         IsVisible="{Binding HasMarker}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="16" Width="16" Text="{Binding Glyph}"
                                                           IsVisible="{Binding !HasMarker}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="TabTitle" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       FontSize="12" />
                                            <Button Grid.Column="2" Classes="NavButton" Width="20" Height="20"
                                                    Click="CloseTab_OnClick" Tag="{Binding}">
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           Text="&#xE711;" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <RepeatButton x:Name="TabScrollIncreaseButton" Classes="TabScrollButton"
                                  Delay="50" Interval="100" Content="&#xEDDA;"
                                  IsVisible="False" Click="TabScrollIncrease_OnClick" />
                </StackPanel>
                <Button x:Name="TabBarAddNewTabButton" Grid.Column="1" Width="30" Height="30"
                        Margin="2,0" Padding="8"
                        VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding NewTabCommand}"
                        ToolTip.Tip="{DynamicResource Tab.New.Tip}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE710;" FontSize="12" />
                </Button>
                <Rectangle x:Name="DragAreaRectangle" Grid.Column="2" Fill="Transparent" />
            </Grid>
        </Border>

        <!-- Files navigation toolbar: 48px row, 38px address control. -->
        <Grid Grid.Row="1" Height="48" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Margin="4,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="NavButton" Command="{Binding SelectedTab.BackCommand}" ToolTip.Tip="{DynamicResource Toolbar.Back}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE76B;" FontSize="14" />
                </Button>
                <Button Classes="NavButton" Command="{Binding SelectedTab.ForwardCommand}" ToolTip.Tip="{DynamicResource Toolbar.Forward}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE76C;" FontSize="14" />
                </Button>
                <Button Classes="NavButton" Command="{Binding SelectedTab.UpCommand}" ToolTip.Tip="{DynamicResource Toolbar.Up}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE74A;" FontSize="14" />
                </Button>
                <Button Classes="NavButton" Command="{Binding SelectedTab.RefreshCommand}" ToolTip.Tip="{DynamicResource Toolbar.Refresh}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>

            <ctrl:AddressBar x:Name="AddressBar" Grid.Column="1"
                             Path="{Binding SelectedTab.PathText, Mode=OneWay}"
                             Breadcrumbs="{Binding SelectedTab.Breadcrumbs}"
                             RootPath="{x:Static m:SpecialFolders.HomeKey}"
                             PathSubmitted="AddressBar_OnPathSubmitted"
                             OpenInNewWindowRequested="AddressBar_OnOpenInNewWindowRequested" />

            <ctrl:SearchField x:Name="SearchBox" Grid.Column="2"
                              Text="{Binding SelectedTab.SearchText, Mode=TwoWay}" />
        </Grid>

        <!-- Sidebar + content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarColumn, Mode=TwoWay}"
                                  MinWidth="{Binding SidebarColumnMin}"
                                  MaxWidth="{x:Static vm:MainViewModel.SidebarMax}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding InfoPaneColumn, Mode=TwoWay}"
                                  MinWidth="{Binding InfoPaneColumnMin}"
                                  MaxWidth="{x:Static vm:MainViewModel.InfoPaneMax}" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarHost" Classes="SidebarPane"
                    IsVisible="{Binding IsSidebarOpen}"
                    Margin="8,0,4,8"
                    CornerRadius="12"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <views:SidebarPane />
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          IsVisible="{Binding IsSidebarOpen}" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" Margin="4,0,4,8" RowDefinitions="Auto,*">
                <!-- Inner toolbar -->
                <Border Margin="0,0,0,4" Padding="4,2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        IsVisible="{Binding SelectedTab.ShowFolder}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="ToolbarButton" Click="New_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE710;" />
                                    <TextBlock Text="{DynamicResource Toolbar.New}" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.CutCommand}" ToolTip.Tip="{DynamicResource Toolbar.Cut}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8C6;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.CopyCommand}" ToolTip.Tip="{DynamicResource Toolbar.Copy}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8C8;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.PasteCommand}" ToolTip.Tip="{DynamicResource Toolbar.Paste}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE77F;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.RenameCommand}" ToolTip.Tip="{DynamicResource Toolbar.Rename}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8AC;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.ShareCommand}" ToolTip.Tip="{DynamicResource Toolbar.Share}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE72D;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.DeleteCommand}" ToolTip.Tip="{DynamicResource Toolbar.Delete}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE74D;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding OpenPropertiesCommand}" ToolTip.Tip="{DynamicResource Menu.File.GetInfo}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE946;" />
                            </Button>
                            <Button Classes="ToolbarButton" Command="{Binding SelectedTab.EmptyTrashCommand}"
                                    IsVisible="{Binding SelectedTab.IsTrash}" Content="{DynamicResource Toolbar.EmptyTrash}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="ToolbarButton" ToolTip.Tip="{DynamicResource Toolbar.Selection}"
                                    Click="Selection_OnClick">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8B3;" />
                            </Button>
                            <Button Classes="ToolbarButton" ToolTip.Tip="{DynamicResource Toolbar.Sort}"
                                    Click="Sort_OnClick">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8CB;" />
                            </Button>
                            <Button Classes="ToolbarButton" ToolTip.Tip="{DynamicResource Toolbar.Layout}"
                                    Click="Layout_OnClick">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8A9;" />
                            </Button>
                            <ToggleButton Classes="ToolbarButton" IsChecked="{Binding ShowInfoPane}"
                                          ToolTip.Tip="{DynamicResource Toolbar.InfoPane}">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xEA49;" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="*,Auto">
                    <Panel IsVisible="{Binding SelectedTab.IsHome}">
                        <views:HomePageView DataContext="{Binding Home}" />
                    </Panel>
                    <Panel IsVisible="{Binding SelectedTab.IsSettings}">
                        <views:SettingsPage DataContext="{Binding SettingsPage}" />
                    </Panel>
                    <Panel IsVisible="{Binding SelectedTab.ShowFolder}">
                        <views:FolderView DataContext="{Binding SelectedTab}" />
                    </Panel>

                    <Border Grid.Row="1" MinHeight="32" Padding="8,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding !SelectedTab.IsHome}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedTab.StatusText}" />
                                <Border Width="1" Height="18" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        IsVisible="{Binding SelectedTab.HasSelection}"
                                        VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedTab.SelectionText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="Transparent"
                          IsVisible="{Binding IsInfoPaneVisible}" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="4" Margin="0,0,8,8"
                        IsVisible="{Binding IsInfoPaneVisible}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{DynamicResource Info.NoSelection}"
                                   IsVisible="{Binding SelectedTab.PreviewItem, Converter={x:Static ObjectConverters.IsNull}}" />
                        <ScrollViewer x:Name="InfoPaneScroll"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding SelectedTab.PreviewItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid MinHeight="{Binding Bounds.Height, ElementName=InfoPaneScroll}">
                                <StackPanel Margin="16" Spacing="10" VerticalAlignment="Center">
                                    <Image Width="96" Height="96" HorizontalAlignment="Center"
                                           Source="{Binding SelectedTab.PreviewItem.Icon}" Stretch="Uniform" />
                                    <TextBlock FontSize="20" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding SelectedTab.PreviewItem.DisplayName}" />
                                    <TextBlock TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding SelectedTab.PreviewItem.ItemType}" />
                                    <TextBlock Classes="Caption" Text="{DynamicResource Info.ItemType}" />
                                    <TextBlock Text="{Binding SelectedTab.PreviewItem.ItemType}" />
                                    <TextBlock Classes="Caption" Text="{DynamicResource Info.Path}" />
                                    <TextBlock Text="{Binding SelectedTab.PreviewItem.Path}" TextWrapping="Wrap" />
                                    <TextBlock Classes="Caption" Text="{DynamicResource Info.Size}" />
                                    <TextBlock Text="{Binding SelectedTab.PreviewItem.SizeText}" />
                                    <TextBlock Classes="Caption" Text="{DynamicResource Info.DateModified}" />
                                    <TextBlock Text="{Binding SelectedTab.PreviewItem.ModifiedText}" />
                                    <TextBlock Classes="Caption" Text="{DynamicResource Info.DateCreated}" />
                                    <TextBlock Text="{Binding SelectedTab.PreviewItem.CreatedText}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</wnd:FAAppWindow>
